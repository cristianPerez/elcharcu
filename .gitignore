# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*

# next.js
/.next/
/out/
next-env.d.ts

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
#
# ⚠️ El patrón tiene que cubrir CUALQUIER `.env.*`, no solo `.env.local`.
# El 2026-08-30 apareció un `.env.prod` con las claves de producción dentro que
# NO encajaba con `.env` ni con `.env*.local`, así que git lo veía como un
# archivo normal y un `git add -A` lo habría subido. No llegó a pasar por poco.
#
# `.env.example` se salva con la negación de abajo: ese sí va al repo, porque
# documenta qué variables hacen falta sin traer ni un valor.
.env
.env.*
!.env.example

# typescript
*.tsbuildinfo

# editor
.vscode/*
!.vscode/extensions.json
.idea

# claude code (local machine settings)
.claude/settings.local.json
/scripts/*/*
/scripts/*/*/

# supabase
/supabase/.temp/*
