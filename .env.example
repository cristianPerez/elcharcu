# ============================================================================
# Variables de entorno de El Charcu
#
# Copia este archivo a `.env.local` y rellena los valores. `.env.local` NO se
# sube a git.
#
# ⚠️ LAS `NEXT_PUBLIC_*` NO PUEDEN SER "SENSITIVE" EN VERCEL.
# Next las sustituye por su valor literal AL COMPILAR —en el bundle del
# navegador y en el del servidor— y las variables Sensitive de Vercel no
# existen durante la compilación. Si se marcan así, quedan vacías en los dos
# lados: el navegador dice "las cuentas no están conectadas" y las rutas de API
# devuelven 500. Pasó en QA el 2026-08-19 y costó una mañana.
# En Vercel van como **Config / Plain**.
# ============================================================================

# --- Supabase (públicas: van al navegador a propósito) ----------------------
# La URL es pública y la clave publicable está diseñada para el navegador: por
# sí sola no da acceso a nada, porque mandan los permisos por fila (RLS).
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=tu_publishable_key

# --- Supabase (solo servidor) -----------------------------------------------
# Estas dos son el RESPALDO de las de arriba: si las públicas vienen vacías, el
# servidor tira de estas y la app no se cae entera. Definirlas cuesta nada.
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_PUBLISHABLE_KEY=tu_publishable_key

# ⚠️ SECRETA: se salta los permisos por fila. Nunca al navegador, nunca al chat.
SUPABASE_SECRET_KEY=tu_secret_key

# Para la CLI (`supabase link`, `db push`). No la usa la app.
SUPABASE_ACCESS_TOKEN=tu_access_token

# --- IA ---------------------------------------------------------------------
GEMINI_API_KEY=tu_api_key_de_gemini
AI_MODEL=gemini-3.6-flash
# DOS topes de gasto diario, en dólares, uno por público.
#   LEADS = sin cuenta o cuenta gratis (la demostración)
#   PRO   = con suscripción activa (el servicio que ya se pagó)
# Separados para que un día de mucho tráfico anónimo NO deje sin asistente a
# quien paga: antes el tope era uno solo y se agotaba para todos a la vez.
# Si una falta o está rota se asume 0 = ese público cortado. Ante una
# configuración mala, mejor un asistente mudo que una factura.
AI_DAILY_BUDGET_LEADS_USD=5
AI_DAILY_BUDGET_PRO_USD=10

# Contesta con texto de mentira SIN llamar a Gemini. Para QA: prueba el flujo
# entero (cupo, muro, historial, eventos) sin gastar ni un centavo.
# ⚠️ Se ignora en producción por código, pase lo que pase con esta variable:
# www.elcharcu.co no puede contestar dosis inventadas ni por accidente.
AI_SIMULAR_IA=0

# --- Correo (Resend) --------------------------------------------------------
# ⚠️ La app NO las usa: los correos de acceso los manda Supabase con su SMTP.
# Resend se configura en el panel de Supabase (Authentication → SMTP Settings).
RESEND_API_KEY=tu_api_key_de_resend
RESEND_FROM=hola@tudominio.co

# --- Video (Bunny Stream) ---------------------------------------------------
# El id de la biblioteca donde están los videos de los cursos.
#
# SIN prefijo NEXT_PUBLIC_ a propósito: el reproductor se arma en el SERVIDOR y
# llega al navegador ya escrito en el HTML, así que se lee al ejecutar. Eso la
# deja fuera de la trampa de arriba — esta SÍ puede ser Sensitive en Vercel.
#
# No es un secreto (viaja en la dirección del reproductor), pero se configura
# para no tocar código al cambiar de cuenta de Bunny.
BUNNY_LIBRARY_ID=733344

# --- Pagos ------------------------------------------------------------------
HOTMART_HOTTOK=tu_hottok

# --- Analítica --------------------------------------------------------------
# Mixpanel: Project Settings > Access Keys > Project Token
NEXT_PUBLIC_MIXPANEL_TOKEN=tu_mixpanel_project_token
