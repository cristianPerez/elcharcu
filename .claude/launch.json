{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "elcharcu-dev",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "elcharcu-prod",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["start", "--port", "4321"],
      "port": 4321
    },
    {
      "name": "elcharcu-preview-limpio",
      "runtimeExecutable": "env",
      "runtimeArgs": [
        "NEXT_DIST_DIR=.next-preview",
        "pnpm",
        "exec",
        "next",
        "dev",
        "--port",
        "3001"
      ],
      "port": 3001
    }
  ]
}
